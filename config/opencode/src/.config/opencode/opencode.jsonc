{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ["otel@https://github.com/zero-two-rafaeltab/opencode-plugin-otel/archive/f7a482309a94b4727e2a3da5db849cbe5bccbf09.tar.gz", {
      "enabled": true,
      "endpoint": "https://otlp.homelab1.local.rafaeltab.com",
      "protocol": "http/protobuf",
      "otlpHeadersHelper": "/home/rafaeltab/.local/bin/opencode-otel-headers",
      "resourceAttributes": "service.name=opencode,deployment.environment.name=homelab",
      // The plugin places prompt content in trace attributes. Keep traces off until
      // it supports metadata-only traces; metrics and prompt-free logs stay enabled.
      "capturePromptInLogs": false,
      "disabledTraces": ["all"],
    }],
  ],
  "autoupdate": true,
  "permission": {
    "bash": {
      "*": "ask",
      "git diff*": "allow",
      "git log*": "allow",
      "git status*": "allow",
      "git show*": "allow",
      "git branch --show-current": "allow",
      "git worktree list*": "allow",
      "git ls-files*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "mkdir*": "allow",
      "tee*": "ask",
      "cat*": "allow",
      "ls*": "allow",
      "make*": "allow",
      "pwd*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "sort*": "allow",
      "rg*": "allow",
      "wc*": "allow",
      "jq*": "allow",
      "cd*": "allow",
      "cargo check*": "allow",
      "cargo build*": "allow",
      "cargo test*": "allow",
      "cargo doc*": "allow",
      "cargo expand*": "allow",
      "tree*": "allow",
      "xargs grep*": "allow",
      "uniq*": "allow",
      "man*": "allow",
      "printf*": "allow",
      "hexdump*": "allow",
      "turbo*": "allow",
      "node*": "allow",
      "rm*": "allow",
      "echo*": "allow",
      "docker*": "allow",
      "dotnet test*": "allow",
      "dotnet build*": "allow",
      "git remote -v": "allow",
      "git ls-tree*": "allow",
      "az bicep build*": "allow",
      "az bicep build-params*": "allow",
      "dotnet list*": "allow",
      "npx skills list*": "allow",
    },
  },
  "agent": {
    "explore": {
      "permission": {
        "bash": {
          // The agent sometimes tries to use these to write files
          "cat*": "deny",
          "echo*": "deny",
        },
        "read": "allow",
      },
    },
    "build": {
      "permission": {
        "bash": {
          "sed": "allow",
          "mkdir*": "allow",
        },
      },
    },
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          "plans/*": "allow",
          "plans/**": "allow",
        },
      },
    },
  },
  "mcp": {
    "vibe_kanban": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "vibe-kanban@latest",
        "--mcp"
      ],
      "enabled": false,
    },
    "ado": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure-devops/mcp",
        "methylium"
      ],
    },
  },
}
