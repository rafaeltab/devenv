{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ["otel@https://github.com/zero-two-rafaeltab/opencode-plugin-otel/archive/f7a482309a94b4727e2a3da5db849cbe5bccbf09.tar.gz", {
      "enabled": true,
      "endpoint": "https://otlp.homelab1.local.rafaeltab.com",
      "protocol": "http/protobuf",
      "otlpHeadersHelper": "/home/rafaeltab/.local/bin/opencode-otel-headers",
      "resourceAttributes": "service.name=opencode,deployment.environment.name=homelab",
      // Traces are intentionally enabled for durable session history. The current
      // plugin includes prompt content in trace input.value attributes.
      "capturePromptInLogs": true,
      "disabledTraces": [],
    }],
  ],
  "autoupdate": true,

  // Temporary workaround for pingdotgg/t3code#2778: T3 Code applies Full access
  // to the parent OpenCode session, but native subagents can inherit this global
  // policy and otherwise pause on permission prompts that T3 does not display.
  // Remove this override after T3 propagates runtime permissions to child sessions.
  // Agent-specific permission overrides are intentionally omitted because they take
  // precedence over this global rule and would make Full access incomplete.
  "permission": "allow",
  "mcp": {
    "vibe_kanban": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "vibe-kanban@latest",
        "--mcp"
      ],
      "enabled": false,
    },
    "ado": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure-devops/mcp",
        "methylium"
      ],
    },
  },
}
